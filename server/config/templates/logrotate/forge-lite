# forge-lite: Laravel process logs (Supervisor programs, scheduler).
# laravel-*.log is rotated by Laravel itself (channel "daily", LOG_DAILY_DAYS)
# and must NOT be matched here — copytruncate would leave .log.1 orphans that
# Laravel's pruning never removes.
# nginx logs are fully covered by /etc/logrotate.d/nginx (/var/log/nginx/*.log,
# shipped by the nginx package); a second entry here is a duplicate that makes
# logrotate fail for the whole nginx config.
/home/deployer/sites/*/shared/storage/logs/worker.log
/home/deployer/sites/*/shared/storage/logs/reverb.log
/home/deployer/sites/*/shared/storage/logs/horizon.log
/home/deployer/sites/*/shared/storage/logs/ssr.log
/home/deployer/sites/*/shared/storage/logs/scheduler.log {
    daily
    missingok
    rotate 14
    compress
    delaycompress
    notifempty
    create 0640 deployer deployer
    copytruncate
}
