#!/usr/bin/env bash
# forge-lite CLI — Unified entry point for forge-lite server management
set -euo pipefail

# Resolve FORGE_LITE_DIR from script location, fallback to /opt/forge-lite
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -d "${SCRIPT_DIR}/../server" ]]; then
    FORGE_LITE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
else
    FORGE_LITE_DIR="/opt/forge-lite"
fi

# Source lib/common.sh if available
if [[ -f "${FORGE_LITE_DIR}/lib/common.sh" ]]; then
    # Runtime path supports repo and installed layouts.
    # shellcheck disable=SC1091
    source "${FORGE_LITE_DIR}/lib/common.sh"
else
    # Minimal fallback for installed CLI
    log_info()  { echo "[INFO]  $*" >&2; }
    log_ok()    { echo "[OK]    $*" >&2; }
    log_warn()  { echo "[WARN]  $*" >&2; }
    log_error() { echo "[ERROR] $*" >&2; }
    die() { log_error "$@"; exit 1; }
    sed_escape_value() {
        printf '%s' "$1" | sed -e 's/[&/\|]/\\&/g'
    }
    get_server_ipv4() {
        local ip
        ip="$(curl -4 -s --max-time 5 ifconfig.me 2>/dev/null)" || true
        if [[ -z "$ip" ]]; then
            ip="$(ip -4 addr show scope global 2>/dev/null | awk '/inet / {print $2}' | cut -d/ -f1 | head -1)" || true
        fi
        printf '%s' "${ip:-}"
    }
    get_server_ipv6() {
        local ip
        ip="$(curl -6 -s --max-time 5 ifconfig.me 2>/dev/null)" || true
        if [[ -z "$ip" ]]; then
            ip="$(ip -6 addr show scope global 2>/dev/null | awk '/inet6 / {print $2}' | cut -d/ -f1 | head -1)" || true
        fi
        printf '%s' "${ip:-}"
    }
    has_ipv6() {
        local ipv6
        ipv6="$(get_server_ipv6)"
        [[ -n "$ipv6" ]]
    }
fi

if [[ -f "${FORGE_LITE_DIR}/lib/validation.sh" && -f "${FORGE_LITE_DIR}/lib/sites.sh" ]]; then
    # Runtime path supports repo and installed layouts.
    # shellcheck disable=SC1091
    source "${FORGE_LITE_DIR}/lib/validation.sh"
    # Runtime path supports repo and installed layouts.
    # shellcheck disable=SC1091
    source "${FORGE_LITE_DIR}/lib/sites.sh"
else
    validate_domain() {
        local domain="$1"
        [[ "$domain" =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?(\.[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?)*\.[a-zA-Z]{2,}$ ]] || \
            die "Invalid domain name: ${domain}"
    }
    _site_config_value() {
        local conf="$1" key="$2" line=""
        line="$(grep -m1 "^${key}=" "$conf" 2>/dev/null)" || true
        printf '%s' "${line#*=}"
    }
    resolve_site() {
        local requested_domain="${1:-}" direct_conf primary_domain conf aliases alias
        local available="" matches_display=""
        local -a alias_list=() match_configs=() match_domains=()
        [[ -n "$requested_domain" ]] || die "Domain required."
        validate_domain "$requested_domain"
        direct_conf="${SITE_CONFIG_DIR:-/etc/forge-lite}/${requested_domain}.conf"
        if [[ -f "$direct_conf" ]]; then
            primary_domain="$(_site_config_value "$direct_conf" DOMAIN)"
            printf '%s\t%s' "${primary_domain:-$requested_domain}" "$direct_conf"
            return 0
        fi
        for conf in "${SITE_CONFIG_DIR:-/etc/forge-lite}"/*.conf; do
            [[ -f "$conf" ]] || continue
            primary_domain="$(_site_config_value "$conf" DOMAIN)"
            [[ -n "$primary_domain" ]] || primary_domain="${conf##*/}"
            primary_domain="${primary_domain%.conf}"
            available="${available:+${available}, }${primary_domain}"
            aliases="$(_site_config_value "$conf" ALIASES)"
            [[ -n "$aliases" ]] || continue
            IFS=',' read -r -a alias_list <<< "$aliases"
            for alias in "${alias_list[@]}"; do
                alias="${alias#"${alias%%[![:space:]]*}"}"
                alias="${alias%"${alias##*[![:space:]]}"}"
                if [[ "$alias" == "$requested_domain" ]]; then
                    match_configs+=("$conf")
                    match_domains+=("$primary_domain")
                    matches_display="${matches_display:+${matches_display}, }${primary_domain}"
                    break
                fi
            done
        done
        [[ ${#match_configs[@]} -gt 0 ]] || \
            die "Site '${requested_domain}' not found. Available: ${available:-<none>}"
        [[ ${#match_configs[@]} -eq 1 ]] || \
            die "Alias '${requested_domain}' is assigned to multiple sites: ${matches_display}. Fix ALIASES in ${SITE_CONFIG_DIR:-/etc/forge-lite}."
        printf '%s\t%s' "${match_domains[0]}" "${match_configs[0]}"
    }
fi

if [[ -f "${FORGE_LITE_DIR}/lib/templates.sh" && -f "${FORGE_LITE_DIR}/lib/scheduler.sh" ]]; then
    # Runtime path supports repo and installed layouts.
    # shellcheck disable=SC1091
    source "${FORGE_LITE_DIR}/lib/templates.sh"
    # Runtime path supports repo and installed layouts.
    # shellcheck disable=SC1091
    source "${FORGE_LITE_DIR}/lib/scheduler.sh"
fi

if [[ -f "${FORGE_LITE_DIR}/lib/logrotate.sh" ]]; then
    # Runtime path supports repo and installed layouts.
    # shellcheck disable=SC1091
    source "${FORGE_LITE_DIR}/lib/logrotate.sh"
fi

if [[ -f "${FORGE_LITE_DIR}/lib/nginx.sh" ]]; then
    # Runtime path supports repo and installed layouts.
    # shellcheck disable=SC1091
    source "${FORGE_LITE_DIR}/lib/nginx.sh"
fi

SITE_CONFIG_DIR="${SITE_CONFIG_DIR:-/etc/forge-lite}"
NGINX_SITES_AVAILABLE="${NGINX_SITES_AVAILABLE:-/etc/nginx/sites-available}"
FORGE_LITE_SSL_BIN="${FORGE_LITE_SSL_BIN:-forge-lite-ssl}"

# Version
FORGE_LITE_VERSION=""
if [[ -f "${FORGE_LITE_DIR}/VERSION" ]]; then
    FORGE_LITE_VERSION=$(cat "${FORGE_LITE_DIR}/VERSION")
fi

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Upsert KEY=VALUE in a config file (grep -F for safety, sed-escaped value)
config_upsert() {
    local file="$1" key="$2" value="$3"
    local escaped_val
    escaped_val=$(sed_escape_value "$value")
    if grep -qF "${key}=" "$file" 2>/dev/null && grep -q "^${key}=" "$file" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${escaped_val}|" "$file"
    else
        echo "${key}=${value}" >> "$file"
    fi
}

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
    cat <<'USAGE'
Usage: forge-lite <command> [args]

Commands:
    site add [flags]                  Add a new site
    site remove <domain> [flags]      Remove a site
    site list                         List all configured sites
    site alias <domain> [flags]       Manage domain aliases (--add, --remove, --list)

    deploy <domain> [flags]           Deploy a site
    deploy setup <domain> [flags]     Configure repo-based deployments
    rollback <domain>                 Rollback to previous release
    status                            Show service status and site overview

    runner setup [flags]              Add a self-hosted GitHub Actions runner
    runner remove --name=N [flags]    Remove a specific runner
    runner status                     Show all runners status
    runner list                       Quick list of all runners

    db <subcommand> [args]            Database management
    env <subcommand> [args]           .env variable management
    ssl <subcommand> [args]           SSL certificate management
    auth <subcommand> <domain>        Basic Auth management (enable, disable, add, remove, list, status)
    reverb <subcommand> <domain>      Laravel Reverb websocket daemon (enable, disable, status)
    php <version>                     Switch default PHP version
    provision [flags]                 Provision the server
    update                            Reinstall CLI tools and completions
    --version                         Show forge-lite version

Run 'forge-lite <command> --help' for command-specific help.
USAGE
    exit 0
}

# ---------------------------------------------------------------------------
# site commands
# ---------------------------------------------------------------------------
cmd_site() {
    [[ $# -ge 1 ]] || die "Usage: forge-lite site <add|remove|list|alias> [args]"
    local sub="$1"; shift

    case "$sub" in
        add)
            exec "${FORGE_LITE_DIR}/sites/add-site.sh" "$@"
            ;;
        remove)
            exec "${FORGE_LITE_DIR}/sites/remove-site.sh" "$@"
            ;;
        list)
            cmd_site_list
            ;;
        alias)
            cmd_site_alias "$@"
            ;;
        -h|--help)
            echo "Usage: forge-lite site <add|remove|list|alias> [args]"
            exit 0
            ;;
        *)
            die "Unknown site command: $sub. Use add, remove, list, or alias."
            ;;
    esac
}

cmd_site_list() {
    if [[ ! -d "$SITE_CONFIG_DIR" ]] || ! ls "${SITE_CONFIG_DIR}"/*.conf &>/dev/null; then
        log_info "No sites configured."
        return 0
    fi

    printf "%-30s %-6s %-8s %-8s %-4s\n" "DOMAIN" "PHP" "HORIZON" "WORKERS" "SSL"
    printf "%-30s %-6s %-8s %-8s %-4s\n" "------" "---" "-------" "-------" "---"

    for conf in "${SITE_CONFIG_DIR}"/*.conf; do
        # Source in subshell to prevent variable pollution
        (
            # shellcheck disable=SC1090
            source "$conf"
            local horizon_display="-"
            local workers_display="${QUEUE_WORKERS:-0}"
            if [[ "${ENABLE_HORIZON:-false}" == "true" ]]; then
                horizon_display="yes"
                workers_display="-"
            fi
            printf "%-30s %-6s %-8s %-8s %-4s\n" \
                "${DOMAIN:-unknown}" \
                "${PHP_VERSION:-?}" \
                "$horizon_display" \
                "$workers_display" \
                "${SSL:-no}"
        )
    done
}

# Helper: update the server_name line in an existing vhost config
_update_vhost_server_names() {
    local domain="$1" server_names="$2"
    local vhost="${NGINX_SITES_AVAILABLE}/${domain}.conf"
    [[ -f "$vhost" ]] || return 0

    # Replace all server_name lines (HTTP redirect + main block)
    sed -i "s|server_name .*\$|server_name ${server_names};|" "$vhost"
}

# Update server_name on disk, but restore the previous vhost if validation or
# reload fails. A failed reload keeps the old runtime config; restoring the
# file also keeps the next reload/restart safe.
_update_vhost_server_names_transactional() {
    local domain="$1" server_names="$2"
    local vhost="${NGINX_SITES_AVAILABLE}/${domain}.conf" backup_vhost=""
    [[ -f "$vhost" ]] || return 0

    backup_vhost="$(mktemp)"
    cp -p "$vhost" "$backup_vhost"
    _update_vhost_server_names "$domain" "$server_names"

    if ! nginx -t 2>/dev/null; then
        mv "$backup_vhost" "$vhost"
        return 1
    fi
    if ! systemctl reload nginx; then
        mv "$backup_vhost" "$vhost"
        nginx -t >/dev/null 2>&1 && systemctl reload nginx >/dev/null 2>&1 || true
        return 1
    fi

    rm -f "$backup_vhost"
}

# Helper: read comma-separated ALIASES from site config into space-separated string
_build_server_names() {
    local domain="$1" aliases="${2:-}"
    local server_names="$domain"
    if [[ -n "$aliases" ]]; then
        server_names="${domain} ${aliases//,/ }"
    fi
    printf '%s' "$server_names"
}

cmd_site_alias() {
    local domain="" add_alias="" remove_alias="" list_only=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --add=*)    add_alias="${1#*=}" ;;
            --remove=*) remove_alias="${1#*=}" ;;
            --list)     list_only=true ;;
            -h|--help)
                echo "Usage: forge-lite site alias <domain> [--add=ALIAS | --remove=ALIAS | --list]"
                exit 0
                ;;
            -*)         die "Unknown option: $1" ;;
            *)          domain="$1" ;;
        esac
        shift
    done

    [[ -n "$domain" ]] || die "Domain is required."
    local requested_domain="$domain" resolved site_conf
    if ! resolved="$(resolve_site "$requested_domain")"; then
        return 1
    fi
    domain="${resolved%%$'\t'*}"
    site_conf="${resolved#*$'\t'}"
    if [[ "$requested_domain" != "$domain" ]]; then
        log_info "${requested_domain} is an alias of ${domain}; aliases are managed for site ${domain}."
    fi

    # Read current aliases
    local current_aliases ssl_enabled
    current_aliases="$(_site_config_value "$site_conf" ALIASES)"
    ssl_enabled="$(_site_config_value "$site_conf" SSL)"
    ssl_enabled="${ssl_enabled:-false}"

    if [[ "$list_only" == true ]]; then
        local server_names
        server_names=$(_build_server_names "$domain" "$current_aliases")
        echo "Server names for ${domain}:"
        echo "  Primary: ${domain}"
        if [[ -n "$current_aliases" ]]; then
            local IFS=','
            for a in $current_aliases; do
                echo "  Alias:   ${a}"
            done
        else
            echo "  (no aliases)"
        fi
        return 0
    fi

    if [[ -n "$add_alias" ]]; then
        validate_domain "$add_alias"
        # Check alias not already present
        if [[ ",$current_aliases," == *",$add_alias,"* ]]; then
            die "Alias '${add_alias}' already exists for ${domain}."
        fi
        local previous_aliases="$current_aliases"
        # Append to aliases
        if [[ -n "$current_aliases" ]]; then
            current_aliases="${current_aliases},${add_alias}"
        else
            current_aliases="$add_alias"
        fi
        config_upsert "$site_conf" "ALIASES" "$current_aliases"

        if [[ "$ssl_enabled" == true ]]; then
            log_info "Expanding the SSL certificate before activating alias '${add_alias}'..."
            if ! "$FORGE_LITE_SSL_BIN" issue "$domain"; then
                config_upsert "$site_conf" "ALIASES" "$previous_aliases"
                die "SSL certificate update failed; alias '${add_alias}' was not activated and the site config was restored."
            fi
            log_ok "Alias '${add_alias}' added for ${domain}"
            log_info "Server names: $(_build_server_names "$domain" "$current_aliases")"
            return 0
        fi

        local server_names
        server_names=$(_build_server_names "$domain" "$current_aliases")
        if ! _update_vhost_server_names_transactional "$domain" "$server_names"; then
            config_upsert "$site_conf" "ALIASES" "$previous_aliases"
            die "NGINX config test failed after adding alias; restored the previous config and vhost."
        fi
        log_ok "Alias '${add_alias}' added for ${domain}"
        log_info "Server names: ${server_names}"

    elif [[ -n "$remove_alias" ]]; then
        validate_domain "$remove_alias"
        # Remove alias from comma-separated list
        local new_aliases=""
        local found=false
        local IFS=','
        for a in $current_aliases; do
            if [[ "$a" == "$remove_alias" ]]; then
                found=true
            else
                [[ -n "$new_aliases" ]] && new_aliases="${new_aliases},"
                new_aliases="${new_aliases}${a}"
            fi
        done
        unset IFS
        [[ "$found" == true ]] || die "Alias '${remove_alias}' not found for ${domain}."

        config_upsert "$site_conf" "ALIASES" "$new_aliases"

        local server_names
        server_names=$(_build_server_names "$domain" "$new_aliases")
        if ! _update_vhost_server_names_transactional "$domain" "$server_names"; then
            config_upsert "$site_conf" "ALIASES" "$current_aliases"
            die "NGINX config test failed after removing alias; restored the previous config and vhost."
        fi
        log_ok "Alias '${remove_alias}' removed from ${domain}"
        log_info "Server names: ${server_names}"
    else
        die "Specify --add=ALIAS, --remove=ALIAS, or --list"
    fi
}

# ---------------------------------------------------------------------------
# deploy commands
# ---------------------------------------------------------------------------
cmd_deploy() {
    [[ $# -ge 1 ]] || die "Usage: forge-lite deploy <domain|setup> [flags]"

    # Check if first arg is the "setup" subcommand
    if [[ "$1" == "setup" ]]; then
        shift
        cmd_deploy_setup "$@"
        return
    fi

    local domain="$1"; shift
    local args=("$@")

    # Check if --artifact or --repo was explicitly passed
    local has_artifact=false has_repo=false
    for arg in "${args[@]+"${args[@]}"}"; do
        case "$arg" in
            --artifact=*) has_artifact=true ;;
            --repo=*)     has_repo=true ;;
        esac
    done

    # Auto-inject repo config if neither --artifact nor --repo was passed
    if [[ "$has_artifact" == false && "$has_repo" == false ]]; then
        local site_conf="${SITE_CONFIG_DIR}/${domain}.conf"
        if [[ -f "$site_conf" ]]; then
            # Read config in subshell to prevent variable pollution
            local deploy_repo deploy_branch
            deploy_repo=$(grep "^DEPLOY_REPO=" "$site_conf" 2>/dev/null | head -1 | cut -d= -f2-) || true
            deploy_branch=$(grep "^DEPLOY_BRANCH=" "$site_conf" 2>/dev/null | head -1 | cut -d= -f2-) || true

            if [[ -n "$deploy_repo" ]]; then
                args+=("--repo=${deploy_repo}")
                if [[ -n "$deploy_branch" ]]; then
                    args+=("--branch=${deploy_branch}")
                fi
                log_info "Using configured repo: ${deploy_repo} (branch: ${deploy_branch:-default})"
            fi
        fi
    fi

    exec "${FORGE_LITE_DIR}/deploy/deploy.sh" "$domain" "${args[@]+"${args[@]}"}"
}

cmd_deploy_setup() {
    local domain="" repo="" branch="main"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --repo=*)   repo="${1#*=}"; shift ;;
            --branch=*) branch="${1#*=}"; shift ;;
            -h|--help)
                echo "Usage: forge-lite deploy setup <domain> --repo=URL [--branch=BRANCH]"
                exit 0
                ;;
            -*)         die "Unknown flag: $1" ;;
            *)          domain="$1"; shift ;;
        esac
    done

    [[ -n "$domain" ]] || die "Domain required. Usage: forge-lite deploy setup <domain> --repo=URL"
    [[ -n "$repo" ]]   || die "Repository URL required. Use --repo=URL"

    local site_conf="${SITE_CONFIG_DIR}/${domain}.conf"
    [[ -f "$site_conf" ]] || die "Site config not found: ${site_conf}. Is '${domain}' a valid site?"

    config_upsert "$site_conf" "DEPLOY_REPO" "$repo"
    config_upsert "$site_conf" "DEPLOY_BRANCH" "$branch"

    log_ok "Deploy config saved for ${domain}"
    log_info "  Repo:   ${repo}"
    log_info "  Branch: ${branch}"
    log_info "Run 'forge-lite deploy ${domain}' to deploy."
}

# ---------------------------------------------------------------------------
# runner commands
# ---------------------------------------------------------------------------
cmd_runner() {
    # die is loaded from common.sh or its local fallback above. Following the
    # runtime-sourced scheduler library can otherwise make ShellCheck report a
    # false forward-definition error here.
    # shellcheck disable=SC2218
    [[ $# -ge 1 ]] || die "Usage: forge-lite runner <setup|remove|status|list> [args]"
    local sub="$1"; shift

    # Module path is selected at runtime.
    # shellcheck disable=SC1091
    source "${FORGE_LITE_DIR}/server/modules/github-runner.sh"

    case "$sub" in
        setup)
            provision_github_runner "$@"
            ;;
        remove)
            remove_github_runner "$@"
            ;;
        status)
            status_github_runner
            ;;
        list)
            list_github_runners
            ;;
        -h|--help)
            cat <<'USAGE'
Usage: forge-lite runner <command> [args]

Commands:
    setup   --repo=URL --token=TOKEN [--name=NAME] [--labels=LABELS]
    remove  --name=NAME --token=TOKEN
    status  Show detailed status of all runners
    list    Quick tabular overview of all runners
USAGE
            exit 0
            ;;
        *)
            die "Unknown runner command: $sub. Use setup, remove, status, or list."
            ;;
    esac
}

# ---------------------------------------------------------------------------
# update command
# ---------------------------------------------------------------------------
_run_catch_up_migrations() {
    local scheduler_template="${FORGE_LITE_DIR}/server/config/templates/cron/laravel-scheduler"
    local cron_dir="${FORGE_LITE_CRON_DIR:-/etc/cron.d}"

    declare -F migrate_scheduler_crons >/dev/null ||
        die "Scheduler migration helpers not found in ${FORGE_LITE_DIR}/lib"

    log_info "Applying catch-up migrations..."
    migrate_scheduler_crons "${SITE_CONFIG_DIR}" "${scheduler_template}" "${cron_dir}"

    # Older templates rotated laravel-*.log (leaving .log.1 orphans) and
    # duplicated the nginx package's own logrotate entry, which made
    # logrotate.service fail every night.
    if declare -F ensure_logrotate_config >/dev/null; then
        ensure_logrotate_config "${FORGE_LITE_DIR}/server/config/templates/logrotate/forge-lite"
    fi

    # Let's Encrypt stopped serving OCSP responders in 2025; ssl_stapling in
    # older vhosts only produces `nginx -t` warnings.
    if declare -F migrate_vhost_ocsp_stapling >/dev/null; then
        migrate_vhost_ocsp_stapling "${NGINX_SITES_AVAILABLE}"
    fi
}

cmd_update() {
    local cli_dir="${FORGE_LITE_DIR}/cli"
    local tools=(php-switch forge-lite-db forge-lite-ssl forge-lite-env forge-lite-auth forge-lite-reverb forge-lite)

    log_info "Reinstalling CLI tools from ${cli_dir} ..."
    for tool in "${tools[@]}"; do
        install -m 755 "${cli_dir}/${tool}" /usr/local/bin/
        log_ok "Installed ${tool}"
    done

    local completion_src="${cli_dir}/completions/forge-lite.bash"
    if [[ -d /etc/bash_completion.d ]]; then
        install -m 644 "$completion_src" /etc/bash_completion.d/forge-lite
        log_ok "Installed bash completion"
    else
        log_warn "Skipped bash completion (/etc/bash_completion.d not found)"
    fi

    _run_catch_up_migrations

    log_ok "forge-lite update complete — ${#tools[@]} tools reinstalled."
}

# ---------------------------------------------------------------------------
# status command
# ---------------------------------------------------------------------------
cmd_status() {
    echo "=== forge-lite Status ==="
    [[ -n "$FORGE_LITE_VERSION" ]] && echo "Version: ${FORGE_LITE_VERSION}"
    echo ""

    echo "--- Services ---"
    local services=(nginx mariadb redis-server supervisor)
    # Add active PHP-FPM services
    for v in 8.1 8.2 8.3 8.4; do
        if systemctl list-unit-files "php${v}-fpm.service" &>/dev/null 2>&1; then
            services+=("php${v}-fpm")
        fi
    done

    for svc in "${services[@]}"; do
        if systemctl is-active --quiet "$svc" 2>/dev/null; then
            printf "  %-20s %s\n" "$svc" "running"
        elif systemctl list-unit-files "${svc}.service" 2>/dev/null | grep -q "$svc"; then
            printf "  %-20s %s\n" "$svc" "stopped"
        fi
    done

    echo ""
    echo "--- Network ---"
    local ipv4 ipv6 dual_stack="no"
    ipv4=$(get_server_ipv4 2>/dev/null) || ipv4=""
    ipv6=$(get_server_ipv6 2>/dev/null) || ipv6=""
    [[ -n "$ipv4" && -n "$ipv6" ]] && dual_stack="yes"
    printf "  %-14s %s\n" "IPv4:" "${ipv4:-not detected}"
    printf "  %-14s %s\n" "IPv6:" "${ipv6:-not detected}"
    printf "  %-14s %s\n" "Dual-Stack:" "$dual_stack"

    echo ""
    echo "--- Disk Usage ---"
    df -h / /home 2>/dev/null | awk 'NR==1 || !/^Filesystem/' | head -3

    echo ""
    echo "--- Sites ---"
    if [[ -d "$SITE_CONFIG_DIR" ]] && ls "${SITE_CONFIG_DIR}"/*.conf &>/dev/null 2>&1; then
        printf "  %-30s %-6s %-4s %-4s\n" "DOMAIN" "PHP" "SSL" "AUTH"
        for conf in "${SITE_CONFIG_DIR}"/*.conf; do
            (
                # shellcheck disable=SC1090
                source "$conf"
                local auth_status="no"
                if [[ -f "/etc/forge-lite/auth/${DOMAIN:-}.conf" ]] && [[ -s "/etc/forge-lite/auth/${DOMAIN:-}.conf" ]]; then
                    auth_status="yes"
                fi
                printf "  %-30s %-6s %-4s %-4s\n" \
                    "${DOMAIN:-unknown}" \
                    "${PHP_VERSION:-?}" \
                    "${SSL:-no}" \
                    "$auth_status"
            )
        done
    else
        echo "  No sites configured."
    fi
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
main() {
    [[ $EUID -eq 0 ]] || die "This script must be run as root (use sudo)."
    [[ $# -ge 1 ]] || usage

    case "$1" in
    site)
        shift; cmd_site "$@" ;;
    deploy)
        shift; cmd_deploy "$@" ;;
    rollback)
        shift
        exec "${FORGE_LITE_DIR}/deploy/rollback.sh" "$@"
        ;;
    runner)
        shift; cmd_runner "$@" ;;
    db)
        shift
        exec forge-lite-db "$@"
        ;;
    env)
        shift
        exec forge-lite-env "$@"
        ;;
    ssl)
        shift
        exec forge-lite-ssl "$@"
        ;;
    auth)
        shift
        exec forge-lite-auth "$@"
        ;;
    reverb)
        shift
        exec forge-lite-reverb "$@"
        ;;
    php)
        shift
        exec php-switch "$@"
        ;;
    provision)
        shift
        exec "${FORGE_LITE_DIR}/server/provision.sh" "$@"
        ;;
    update)
        cmd_update
        ;;
    status)
        cmd_status
        ;;
    --version|-v)
        if [[ -n "$FORGE_LITE_VERSION" ]]; then
            echo "forge-lite ${FORGE_LITE_VERSION}"
        else
            echo "forge-lite (version unknown)"
        fi
        ;;
    -h|--help)
        usage
        ;;
        *)
            die "Unknown command: $1. Run 'forge-lite --help' for usage."
            ;;
    esac
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
