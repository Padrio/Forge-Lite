#!/usr/bin/env bash
# forge-lite CLI: forge-lite-env — .env variable management (list|get|set|delete)
set -euo pipefail

# Source lib/common.sh if available (provides log_*, sed_escape_value,
# format_dotenv_value, etc.). Try the script-relative path first (repo
# checkout); fall back to /opt/forge-lite (installed layout).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -f "${SCRIPT_DIR}/../lib/common.sh" ]]; then
    export FORGE_LITE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
    source "${FORGE_LITE_DIR}/lib/common.sh"
elif [[ -f /opt/forge-lite/lib/common.sh ]]; then
    export FORGE_LITE_DIR=/opt/forge-lite
    source /opt/forge-lite/lib/common.sh
else
    # Minimal fallback for installed CLI without lib/ available
    log_info()  { echo "[INFO]  $*" >&2; }
    log_ok()    { echo "[OK]    $*" >&2; }
    log_warn()  { echo "[WARN]  $*" >&2; }
    log_error() { echo "[ERROR] $*" >&2; }
    die() { log_error "$@"; exit 1; }
    enforce_secret_perms() {
        local file="$1" owner="${2:-deployer:deployer}" mode="${3:-600}"
        [[ -e "$file" ]] || return 0
        local cur_owner cur_mode changed=false
        cur_owner="$(stat -c '%U:%G' "$file" 2>/dev/null || true)"
        cur_mode="$(stat -c '%a' "$file" 2>/dev/null || true)"
        if [[ -n "$cur_owner" && "$cur_owner" != "$owner" ]]; then
            if chown "$owner" "$file"; then changed=true; fi
        fi
        if [[ -n "$cur_mode" && "$cur_mode" != "$mode" ]]; then
            if chmod "$mode" "$file"; then changed=true; fi
        fi
        [[ "$changed" == true ]] && \
            log_warn "Hardened permissions on ${file} (was ${cur_owner} ${cur_mode} -> ${owner} ${mode})"
        return 0
    }
    sed_escape_value() {
        printf '%s' "$1" | sed -e 's/[&/\|]/\\&/g'
    }
    format_dotenv_value() {
        local value="$1"
        if [[ "$value" =~ ^\"(.*)\"$ ]]; then
            value="${BASH_REMATCH[1]}"
        elif [[ "$value" =~ ^\'(.*)\'$ ]]; then
            value="${BASH_REMATCH[1]}"
        fi
        if [[ "$value" =~ [[:space:]\"\'\#\$\&\|\;\(\)\<\>\`\\] || -z "$value" ]]; then
            printf '"%s"' "${value//\"/\\\"}"
        else
            printf '%s' "$value"
        fi
    }
fi

[[ $EUID -eq 0 ]] || die "This script must be run as root (use sudo)."

SITE_CONFIG_DIR="${SITE_CONFIG_DIR:-/etc/forge-lite}"

usage() {
    cat <<'USAGE'
Usage: forge-lite-env <command> <domain> [args]

Commands:
    list <domain>               Show all .env variables
    get <domain> <key>          Get a single variable's value
    set <domain> <key> <value>  Set or update a variable
    delete <domain> <key>       Remove a variable
    audit [--fix]               Check all sites' .env perms (deployer:deployer 600)
USAGE
    exit 0
}

# Resolve .env path from site config
resolve_env_path() {
    local domain="$1"
    local site_config="/etc/forge-lite/${domain}.conf"
    [[ -f "$site_config" ]] || die "Site config not found: ${site_config}. Is '${domain}' a valid site?"

    # shellcheck disable=SC1090
    source "$site_config"
    local site_dir="${SITE_DIR:-/home/deployer/sites/${domain}}"
    local env_file="${site_dir}/shared/.env"
    [[ -f "$env_file" ]] || die ".env not found: ${env_file}"
    echo "$env_file"
}

cmd_list() {
    local domain="$1"
    [[ -n "$domain" ]] || die "Domain required. Usage: forge-lite-env list <domain>"
    local env_file
    env_file=$(resolve_env_path "$domain")
    cat "$env_file"
}

cmd_get() {
    local domain="$1"
    local key="$2"
    [[ -n "$domain" ]] || die "Domain required."
    [[ -n "$key" ]] || die "Key required. Usage: forge-lite-env get <domain> <key>"
    local env_file
    env_file=$(resolve_env_path "$domain")

    local line value
    line=$(grep -F "${key}=" "$env_file" | grep "^${key}=" | head -1) || die "Variable '${key}' not found in .env"
    value="${line#*=}"
    # Strip surrounding quotes if present
    if [[ "$value" =~ ^\"(.*)\"$ ]]; then
        value="${BASH_REMATCH[1]}"
    elif [[ "$value" =~ ^\'(.*)\'$ ]]; then
        value="${BASH_REMATCH[1]}"
    fi
    echo "$value"
}

cmd_set() {
    local domain="$1"
    local key="$2"
    local value="$3"
    [[ -n "$domain" ]] || die "Domain required."
    [[ -n "$key" ]] || die "Key required. Usage: forge-lite-env set <domain> <key> <value>"
    local env_file
    env_file=$(resolve_env_path "$domain")

    local quoted_value escaped_val
    quoted_value=$(format_dotenv_value "$value")
    escaped_val=$(sed_escape_value "$quoted_value")
    if grep -q "^${key}=" "$env_file"; then
        sed -i "s|^${key}=.*|${key}=${escaped_val}|" "$env_file"
        log_ok "Updated ${key}"
    else
        echo "${key}=${quoted_value}" >> "$env_file"
        log_ok "Added ${key}"
    fi
    # sed -i / >> as root can flip owner->root; re-assert 600 deployer:deployer.
    enforce_secret_perms "$env_file"
}

cmd_delete() {
    local domain="$1"
    local key="$2"
    [[ -n "$domain" ]] || die "Domain required."
    [[ -n "$key" ]] || die "Key required. Usage: forge-lite-env delete <domain> <key>"
    local env_file
    env_file=$(resolve_env_path "$domain")

    if grep -qF "${key}=" "$env_file" && grep -q "^${key}=" "$env_file"; then
        sed -i "/^${key}=/d" "$env_file"
        log_ok "Deleted ${key}"
        # sed -i as root can flip owner->root; re-assert 600 deployer:deployer.
        enforce_secret_perms "$env_file"
    else
        die "Variable '${key}' not found in .env"
    fi
}

# audit [--fix]
#   Fleet-wide check: every site's shared/.env must be 600 deployer:deployer.
#   Reports drift; --fix corrects it in place via enforce_secret_perms.
#   Exits non-zero when drift is found without --fix (scripting signal).
cmd_audit() {
    local fix=false
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --fix)      fix=true ;;
            -h|--help)
                cat <<'USAGE'
Usage: forge-lite-env audit [--fix]
  Checks every site's shared/.env for correct ownership and permissions
  (deployer:deployer 600). Reports drift; --fix corrects it in place.
USAGE
                return 0
                ;;
            *)          die "Unknown option: $1" ;;
        esac
        shift
    done

    local conf_dir="${SITE_CONFIG_DIR:-/etc/forge-lite}"
    shopt -s nullglob
    local confs=("${conf_dir}"/*.conf)
    shopt -u nullglob
    if [[ ${#confs[@]} -eq 0 ]]; then
        log_info "No sites configured."
        return 0
    fi

    local conf domain site_dir env_file owner mode total=0 drift=0
    for conf in "${confs[@]}"; do
        domain="$(basename "$conf" .conf)"
        site_dir="$(
            # shellcheck disable=SC1090
            source "$conf"
            printf '%s' "${SITE_DIR:-/home/deployer/sites/${domain}}"
        )"
        env_file="${site_dir}/shared/.env"
        if [[ ! -f "$env_file" ]]; then
            log_warn "${domain}: .env missing (${env_file})"
            continue
        fi
        total=$((total + 1))
        owner="$(stat -c '%U:%G' "$env_file" 2>/dev/null || true)"
        mode="$(stat -c '%a' "$env_file" 2>/dev/null || true)"
        if [[ "$owner" != "deployer:deployer" || "$mode" != "600" ]]; then
            drift=$((drift + 1))
            if [[ "$fix" == true ]]; then
                enforce_secret_perms "$env_file"
                log_ok "${domain}: fixed (.env was ${owner} ${mode})"
            else
                log_warn "${domain}: DRIFT — .env is ${owner} ${mode} (expected deployer:deployer 600)"
            fi
        else
            log_info "${domain}: ok (${owner} ${mode})"
        fi
    done

    if [[ "$fix" != true && $drift -gt 0 ]]; then
        log_warn "${drift}/${total} site(s) have .env permission drift. Re-run: forge-lite-env audit --fix"
        return 1
    fi
    log_ok "Audit complete — ${total} site(s) checked, ${drift} corrected/drifting."
}

# Main dispatch
[[ $# -ge 1 ]] || usage

case "$1" in
    list)    cmd_list "${2:-}" ;;
    get)     cmd_get "${2:-}" "${3:-}" ;;
    set)     cmd_set "${2:-}" "${3:-}" "${4:-}" ;;
    delete)  cmd_delete "${2:-}" "${3:-}" ;;
    audit)   cmd_audit "${@:2}" ;;
    -h|--help) usage ;;
    *)       die "Unknown command: $1. Run with --help for usage." ;;
esac
