#!/usr/bin/env bash
# forge-lite CLI: forge-lite-reverb — Laravel Reverb websocket daemon management
#
# Installs/reinstalls the Reverb supervisor program for an EXISTING site and
# wires the nginx websocket proxy into the site's per-site `sites-extra` include.
# Fills the gap that add-site.sh's --enable-reverb only covers at site creation.
#
# The nginx proxy is written ONLY for sites where reverb is enabled (it lives in
# the per-site sites-extra include, not the shared vhost template), and is scoped
# by regex to the Pusher-protocol paths — client WS `/app/{key}` and server API
# `/apps/{id}/...` — so it never shadows ordinary app routes such as
# /appointments or /applications.
set -euo pipefail

# Resolve FORGE_LITE_DIR like cli/forge-lite: repo checkout if ../server exists,
# otherwise the installed location. Reverb rendering needs the template engine and
# the supervisor template, so (unlike forge-lite-auth) there is no lib-less
# fallback — the libs always exist under FORGE_LITE_DIR on a provisioned server.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ -d "${SCRIPT_DIR}/../server" ]]; then
    FORGE_LITE_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
else
    FORGE_LITE_DIR="/opt/forge-lite"
fi
export FORGE_LITE_DIR

source "${FORGE_LITE_DIR}/lib/common.sh"
source "${FORGE_LITE_DIR}/lib/templates.sh"
source "${FORGE_LITE_DIR}/lib/validation.sh"

[[ $EUID -eq 0 ]] || die "This script must be run as root (use sudo)."

SITE_CONFIG_DIR="/etc/forge-lite"
TEMPLATE_DIR="${FORGE_LITE_DIR}/server/config/templates"
EXTRA_DIR="/etc/nginx/sites-extra"
REVERB_MARK_BEGIN="# BEGIN forge-lite reverb"
REVERB_MARK_END="# END forge-lite reverb"

usage() {
    cat <<'USAGE'
Usage: forge-lite reverb <command> <domain>

Commands:
    enable <domain>
        Install the Reverb supervisor daemon for an existing site and add the
        nginx websocket proxy to the site's sites-extra include (SSL sites).
        Records ENABLE_REVERB=true. Idempotent — safe to re-run to repair.

    disable <domain>
        Remove the Reverb supervisor daemon and the nginx websocket proxy.
        Records ENABLE_REVERB=false.

    status <domain>
        Show the Reverb daemon state, nginx proxy state, and ENABLE_REVERB flag.

Note: after enabling, set BROADCAST_CONNECTION=reverb and the REVERB_*/VITE_REVERB_*
keys in the site's shared/.env, then rebuild the frontend (npm run build) so the
websocket connection goes live. See docs/reverb_deployment.md in the app repo.
USAGE
    exit 0
}

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

# Read a single KEY's value from a site config (grep + cut, matches cmd_deploy).
_site_config_get() {
    local site_conf="$1" key="$2"
    grep "^${key}=" "$site_conf" 2>/dev/null | head -1 | cut -d= -f2- || true
}

# Upsert KEY=VALUE in a site config (sed-replace if present, append otherwise —
# matches forge-lite-auth's update_site_config). Only used with literal true/false.
_site_config_set() {
    local site_conf="$1" key="$2" value="$3"
    if grep -q "^${key}=" "$site_conf" 2>/dev/null; then
        sed -i "s|^${key}=.*|${key}=${value}|" "$site_conf"
    else
        echo "${key}=${value}" >> "$site_conf"
    fi
}

# Emit the marked nginx reverb proxy block to stdout. Quoted heredoc keeps the
# nginx $variables literal. The regex is scoped to the Pusher protocol: client
# websocket /app/{key} (key = alphanumeric app key, query string is not part of
# the location match) and server API /apps/{id}/... . Everything else under
# /app* — bot probes such as /app/settings.py, or app routes like /applications
# and /appointments — stays with Laravel instead of hitting the Reverb daemon.
_reverb_proxy_block() {
    cat <<'BLOCK'
# BEGIN forge-lite reverb
# Laravel Reverb websocket proxy (managed by `forge-lite reverb`). Proxies only
# the Pusher-protocol endpoints to the local Reverb daemon: client WS /app/{key}
# and server API /apps/{id}/... . nginx terminates TLS; upstream is plain ws.
location ~ ^/(app/[A-Za-z0-9_-]+$|apps/[A-Za-z0-9_-]+/) {
    proxy_pass http://127.0.0.1:8080;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_read_timeout 3600s;
    proxy_send_timeout 3600s;
}
# END forge-lite reverb
BLOCK
}

# Ensure the per-site vhost pulls in its sites-extra include. Sites created before
# the sites-extra feature lack the include line; inject it (mirrors
# forge-lite-auth's ensure_vhost_include). Idempotent via the grep guard.
_ensure_vhost_includes_extra() {
    local domain="$1"
    local vhost="/etc/nginx/sites-available/${domain}.conf"
    [[ -f "$vhost" ]] || return 0
    if ! grep -q "sites-extra/${domain}.conf" "$vhost" 2>/dev/null; then
        sed -i '/location \/ {/i\    # Per-site nginx extras (managed by forge-lite)\n    include /etc/nginx/sites-extra/'"${domain}"'.conf;' "$vhost"
        log_info "Injected sites-extra include into existing vhost"
    fi
}

# ---------------------------------------------------------------------------
# Commands
# ---------------------------------------------------------------------------

cmd_enable() {
    local domain="${1:-}"
    [[ -n "$domain" ]] || die "Domain is required. Usage: forge-lite reverb enable <domain>"
    validate_domain "$domain"

    local site_conf="${SITE_CONFIG_DIR}/${domain}.conf"
    [[ -f "$site_conf" ]] || die "Site config not found for ${domain}. Add the site first."

    local ssl
    ssl=$(_site_config_get "$site_conf" "SSL")

    # 1. Supervisor program — identical render call to add-site.sh.
    log_info "Rendering Reverb supervisor config..."
    render_template "${TEMPLATE_DIR}/supervisor/laravel-reverb.conf" \
        "/etc/supervisor/conf.d/${domain}-reverb.conf" \
        "DOMAIN=${domain}"
    supervisorctl reread
    supervisorctl update
    log_ok "Reverb supervisor program installed (${domain}-reverb on 127.0.0.1:8080)"

    # 2. nginx websocket proxy — written per-site into sites-extra, only for SSL
    #    sites (wss needs TLS). Conditional + scoped, so non-reverb sites are
    #    never touched and app routes are never shadowed.
    if [[ "$ssl" == "true" ]]; then
        local extra="${EXTRA_DIR}/${domain}.conf"
        local backup="${extra}.pre-reverb"

        mkdir -p "$EXTRA_DIR"
        if [[ ! -f "$extra" ]]; then
            touch "$extra"
            chmod 644 "$extra"
        fi
        _ensure_vhost_includes_extra "$domain"

        cp -a "$extra" "$backup"
        # Idempotent: drop any prior managed block, then append a fresh one.
        sed -i "/${REVERB_MARK_BEGIN}/,/${REVERB_MARK_END}/d" "$extra"
        _reverb_proxy_block >> "$extra"

        if nginx -t 2>/dev/null; then
            systemctl reload nginx
            rm -f "$backup"
            log_ok "nginx websocket proxy active (/app/{key}, /apps/{id}/* -> 127.0.0.1:8080)"
        else
            mv -f "$backup" "$extra"
            die "NGINX config test failed adding reverb proxy for ${domain}; reverted sites-extra."
        fi
    else
        log_warn "Site ${domain} has no SSL vhost — websocket proxy needs TLS (wss)."
        log_warn "Daemon is installed; run 'forge-lite ssl issue ${domain}', then re-run 'forge-lite reverb enable ${domain}'."
    fi

    # 3. Persist feature state.
    _site_config_set "$site_conf" "ENABLE_REVERB" "true"

    log_ok "Reverb enabled for ${domain}"
    log_info "Next: set BROADCAST_CONNECTION=reverb and REVERB_*/VITE_REVERB_* in shared/.env,"
    log_info "rebuild the frontend (npm run build), then: supervisorctl restart ${domain}-reverb"
}

cmd_disable() {
    local domain="${1:-}"
    [[ -n "$domain" ]] || die "Domain is required. Usage: forge-lite reverb disable <domain>"
    validate_domain "$domain"

    local site_conf="${SITE_CONFIG_DIR}/${domain}.conf"
    [[ -f "$site_conf" ]] || die "Site config not found for ${domain}."

    # Remove the supervisor program.
    local conf="/etc/supervisor/conf.d/${domain}-reverb.conf"
    if [[ -f "$conf" ]]; then
        supervisorctl stop "${domain}-reverb:*" 2>/dev/null || true
        rm -f "$conf"
        supervisorctl reread
        supervisorctl update
        log_ok "Reverb supervisor program removed for ${domain}"
    else
        log_info "No Reverb supervisor config present for ${domain} (nothing to remove)"
    fi

    # Remove the nginx proxy block from sites-extra (leave the include + any other
    # custom directives intact).
    local extra="${EXTRA_DIR}/${domain}.conf"
    if [[ -f "$extra" ]] && grep -q "${REVERB_MARK_BEGIN}" "$extra" 2>/dev/null; then
        sed -i "/${REVERB_MARK_BEGIN}/,/${REVERB_MARK_END}/d" "$extra"
        if nginx -t 2>/dev/null; then
            systemctl reload nginx
            log_ok "Removed nginx websocket proxy for ${domain}"
        else
            log_warn "nginx -t failed after removing reverb proxy; left nginx running — inspect ${extra}"
        fi
    fi

    _site_config_set "$site_conf" "ENABLE_REVERB" "false"
    log_ok "Reverb disabled for ${domain}"
    log_info "Set BROADCAST_CONNECTION back (e.g. log) in shared/.env so the app stops broadcasting."
}

cmd_status() {
    local domain="${1:-}"
    [[ -n "$domain" ]] || die "Domain is required. Usage: forge-lite reverb status <domain>"

    local site_conf="${SITE_CONFIG_DIR}/${domain}.conf"
    local flag=""
    [[ -f "$site_conf" ]] && flag=$(_site_config_get "$site_conf" "ENABLE_REVERB")

    local conf="/etc/supervisor/conf.d/${domain}-reverb.conf"
    local extra="${EXTRA_DIR}/${domain}.conf"

    echo "Reverb for ${domain}:"
    echo "  ENABLE_REVERB:   ${flag:-false}"
    if [[ -f "$extra" ]] && grep -q "${REVERB_MARK_BEGIN}" "$extra" 2>/dev/null; then
        echo "  nginx proxy:     present (${extra})"
    else
        echo "  nginx proxy:     (none)"
    fi
    if [[ -f "$conf" ]]; then
        echo "  Supervisor conf: ${conf}"
        supervisorctl status "${domain}-reverb:*" 2>/dev/null | sed 's/^/  /' || \
            echo "  (supervisor status unavailable)"
    else
        echo "  Supervisor conf: (none)"
    fi
}

# ---------------------------------------------------------------------------
# Main dispatch
# ---------------------------------------------------------------------------
[[ $# -ge 1 ]] || usage

case "$1" in
    enable)    shift; cmd_enable "${1:-}" ;;
    disable)   shift; cmd_disable "${1:-}" ;;
    status)    shift; cmd_status "${1:-}" ;;
    -h|--help) usage ;;
    *)         die "Unknown command: $1. Run 'forge-lite reverb --help' for usage." ;;
esac
